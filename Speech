import tkinter as tk
from tkinter import ttk, messagebox
from gtts import gTTS
import pygame
import tempfile
import os
import threading


class TTS:
    def __init__(self, language='ru', slow_speech=False):
        self.language = language
        self.slow_speech = slow_speech
        self.temp_files = []
        pygame.mixer.init()

    def speak(self, text):
        try:
            tts = gTTS(text, lang=self.language, slow=self.slow_speech)
            with tempfile.NamedTemporaryFile(delete=False, suffix='.mp3') as fp:
                temp_file = fp.name
                tts.save(temp_file)
                self.temp_files.append(temp_file)
            pygame.mixer.music.load(temp_file)
            pygame.mixer.music.play()
            while pygame.mixer.music.get_busy():
                pygame.time.delay(100)
        except Exception as e:
            print(f"Ошибка при воспроизведении: {e}")

    def stop(self):
        for temp_file in self.temp_files:
            try:
                os.remove(temp_file)
            except FileNotFoundError:
                pass
        self.temp_files.clear()
        print("Временные файлы очищены.")


class TTSHandler:
    def __init__(self):
        self.tts = None
        self.is_playing = False

    def initialize_tts(self, language, slow_speech):
        self.tts = TTS(language=language, slow_speech=slow_speech)
        self.is_playing = False

    def speak_text(self, text, callback=None):
        if self.is_playing:
            return
        self.is_playing = True

        def playback():
            if self.tts:
                self.tts.speak(text)
            self.is_playing = False
            if callback:
                callback()

        thread = threading.Thread(target=playback)
        thread.daemon = True
        thread.start()

    def stop_playback(self):
        if self.tts:
            self.tts.stop()
        self.is_playing = False


class TTSApp:
    def __init__(self, root):
        self.root = root
        self.root.title("TTS-приложение")
        self.root.geometry("500x400")
        self.root.resizable(False, False)

        # Установка серого фона
        self.root.configure(bg='#f0f0f0')

        # Минималистичные стили
        self.style = ttk.Style()
        self.style.theme_use('clam')

        # Черный текст на сером фоне
        self.style.configure("TLabel",
                             font=("Arial", 11),
                             foreground="black",
                             background="#f0f0f0")

        self.style.configure("TButton",
                             font=("Arial", 10),
                             padding=5,
                             background="#e0e0e0",
                             foreground="black",
                             borderwidth=1,
                             relief="flat")
        
        self.style.map("TButton",
                       background=[('active', '#d0d0d0')])

        self.tts_handler = TTSHandler()
        self.setup_ui()
        self.tts_handler.initialize_tts('ru', False)

    def setup_ui(self):
        # Простой заголовок
        title_label = ttk.Label(self.root,
                                text="Текст в речь",
                                font=("Arial", 16))
        title_label.pack(pady=10)

        # Текстовое поле
        text_frame = ttk.Frame(self.root)
        text_frame.pack(padx=20, pady=10, fill="both", expand=True)

        self.text_entry = tk.Text(text_frame,
                                  height=8,
                                  font=("Arial", 11),
                                  bg="white",
                                  fg="black",
                                  relief="solid",
                                  borderwidth=1)
        self.text_entry.pack(fill="both", expand=True)

        # Простые настройки в одной строке
        settings_frame = ttk.Frame(self.root)
        settings_frame.pack(padx=20, pady=5, fill="x")

        ttk.Label(settings_frame, text="Язык:").pack(side="left", padx=(0, 10))

        self.language_var = tk.StringVar(value="ru")
        language_combo = ttk.Combobox(settings_frame,
                                      textvariable=self.language_var,
                                      values=["ru", "en", "es", "fr", "de"],
                                      width=8,
                                      state="readonly")
        language_combo.pack(side="left", padx=(0, 20))

        self.slow_var = tk.BooleanVar()
        slow_check = ttk.Checkbutton(settings_frame,
                                     text="Медленно",
                                     variable=self.slow_var)
        slow_check.pack(side="left")

        # Простые кнопки
        button_frame = ttk.Frame(self.root)
        button_frame.pack(pady=10)

        self.speak_button = ttk.Button(button_frame,
                                       text="Озвучить",
                                       command=self.on_speak,
                                       width=10)
        self.speak_button.pack(side="left", padx=5)

        self.stop_button = ttk.Button(button_frame,
                                      text="Стоп",
                                      command=self.on_stop,
                                      state="disabled",
                                      width=10)
        self.stop_button.pack(side="left", padx=5)

        clear_button = ttk.Button(button_frame,
                                  text="Очистить",
                                  command=self.clear_text,
                                  width=10)
        clear_button.pack(side="left", padx=5)

        # Простая строка статуса
        self.status_var = tk.StringVar(value="Готов")
        status_label = ttk.Label(self.root,
                                 textvariable=self.status_var,
                                 relief="flat",
                                 anchor="center",
                                 font=("Arial", 9))
        status_label.pack(side="bottom", fill="x", pady=5)

    def on_speak(self):
        text = self.text_entry.get("1.0", "end-1c").strip()
        if not text:
            messagebox.showwarning("Внимание", "Введите текст для озвучивания!")
            return

        language = self.language_var.get()
        slow_speech = self.slow_var.get()

        self.tts_handler.initialize_tts(language, slow_speech)
        self.speak_button.config(state="disabled")
        self.stop_button.config(state="normal")
        self.status_var.set("Воспроизведение...")

        self.tts_handler.speak_text(text, callback=self.playback_finished)

    def playback_finished(self):
        self.speak_button.config(state="normal")
        self.stop_button.config(state="disabled")
        self.status_var.set("Завершено")

    def on_stop(self):
        self.tts_handler.stop_playback()
        self.playback_finished()

    def clear_text(self):
        self.text_entry.delete("1.0", "end")


if __name__ == "__main__":
    root = tk.Tk()
    app = TTSApp(root)
    root.mainloop()
